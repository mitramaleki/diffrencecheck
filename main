    textarea { width: 100%; height: 200px; padding: 1rem; border-radius: 14px; border: 1px solid #d0d9e8; font-family: 'Monaco', 'Menlo', monospace; font-size: 0.85rem; resize: vertical; background: #fafcff; }
    label { font-weight: 500; display: block; margin-bottom: 0.4rem; color: #1e2b3c; }
    .btn { background: #1e2b3c; color: white; border: none; padding: 0.8rem 2rem; border-radius: 40px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: 0.2s; }
    .btn:hover { background: #0f1a2b; transform: scale(1.01); }
    .btn-outline { background: transparent; border: 1px solid #1e2b3c; color: #1e2b3c; margin-left: 0.8rem; }
