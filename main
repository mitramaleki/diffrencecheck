<div class="flex">
  <button class="btn" id="compareBtn">🔎 Compare lists</button>
  <button class="btn btn-outline" id="clearBtn">Clear results</button>
  <span class="stats" id="statsDisplay">📊 <span id="statNew">0</span> new · <span id="statOld">0</span> old · <span id="statSimilar">0</span> similar</span>
</div>

<div class="card" id="resultContainer">
  <div id="resultTableWrapper">
    <div class="empty-state">⬆️ Paste both lists and click “Compare lists”</div>
  </div>
</div>

<script>
  (function() {
    // ---------- helpers ----------
    function normalizeUrl(url) {
      if (!url) return '';
      try {
        let u = new URL(url.trim());
        let host = u.hostname.replace(/^www\./, '');
        let path = u.pathname.replace(/\/+$/, '') || '/';
        // remove trailing slash, ignore common "about", "index" etc.
        let cleanPath = path.replace(/\/index(\.html?)?$/i, '').replace(/\/about$/i, '').replace(/\/$/,'');
        if (!cleanPath) cleanPath = '/';
        return (host + cleanPath).toLowerCase();
      } catch {
        return url.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/\/+$/, '');
      }
    }

    function normalizeName(name) {
      return name.trim().toLowerCase().replace(/\s+/g, ' ').replace(/[^a-z0-9 ]/g, '');
    }

    function parseList(text) {
      const lines = text.split(/\n/).filter(line => line.trim() !== '');
      return lines.map(line => {
        // try comma separated: "name, url"
        let parts = line.split(',').map(s => s.trim());
        let name = parts[0] || '';
        let url = parts.slice(1).join(',').trim();
        // if no comma, treat whole line as URL, extract name from domain
        if (!url && name) {
          try {
            let u = new URL(name);
            let host = u.hostname.replace(/^www\./, '');
            let domain = host.split('.')[0] || host;
            name = domain.charAt(0).toUpperCase() + domain.slice(1);
            url = name;
          } catch {
            url = name;
            name = 'unknown';
          }
        }
        // if url missing, try to use name as url
        if (!url && name) url = name;
        return { raw: line, name: name, url: url };
      });
    }

    function getSimilarity(str1, str2) {
      if (!str1 || !str2) return 0;
      const a = str1.toLowerCase(), b = str2.toLowerCase();
      if (a === b) return 100;
      if (a.includes(b) || b.includes(a)) {
        const longer = a.length > b.length ? a : b;
        const shorter = a.length > b.length ? b : a;
        return Math.round((shorter.length / longer.length) * 100);
      }
      // simple char-based similarity (quick)
      let matches = 0;
      const maxLen = Math.max(a.length, b.length);
      for (let i = 0; i < Math.min(a.length, b.length); i++) {
        if (a[i] === b[i]) matches++;
      }
      return Math.round((matches / maxLen) * 100);
    }

    // ---------- main comparison ----------
    function compareLists(masterText, newText) {
      const masterItems = parseList(masterText);
      const newItems = parseList(newText);

      if (masterItems.length === 0 || newItems.length === 0) {
        return { results: [], stats: { new: 0, old: 0, similar: 0 } };
      }

      const results = [];
      let newCount = 0, oldCount = 0, similarCount = 0;

      for (const newItem of newItems) {
        let bestMatch = null;
        let bestScore = 0;
        let matchType = 'new';
        let matchedMaster = null;
        let nameSim = 0, urlSim = 0;

        for (const master of masterItems) {
          const nName = normalizeName(newItem.name);
          const mName = normalizeName(master.name);
          const nameSimilarity = getSimilarity(nName, mName);

          const nUrl = normalizeUrl(newItem.url);
          const mUrl = normalizeUrl(master.url);
          const urlSimilarity = getSimilarity(nUrl, mUrl);

          // combined score: weighted, url more important
          let combined = (nameSimilarity * 0.4) + (urlSimilarity * 0.6);
          if (nUrl === mUrl) combined = 100;
          if (nName === mName) combined = Math.max(combined, 85);

          if (combined > bestScore) {
            bestScore = combined;
            bestMatch = master;
            nameSim = nameSimilarity;
            urlSim = urlSimilarity;
          }
        }

        // threshold: > 75% similar → old, between 60-75 → similar, < 60 → new
        let status = 'new';
        let statusLabel = '🆕 NEW';
        let tagClass = 'tag-new';
        if (bestScore >= 75) {
          status = 'old';
          statusLabel = '🔄 OLD';
          tagClass = 'tag-old';
          oldCount++;
        } else if (bestScore >= 55) {
          status = 'similar';
          statusLabel = '⚠️ SIMILAR';
          tagClass = 'tag-similar';
          similarCount++;
        } else {
          newCount++;
        }

        results.push({
          newItem: newItem,
          masterMatch: bestMatch,
          similarity: bestScore,
          nameSim: nameSim,
          urlSim: urlSim,
          status: status,
          statusLabel: statusLabel,
          tagClass: tagClass
        });
      }

      return { results, stats: { new: newCount, old: oldCount, similar: similarCount } };
    }

    // ---------- render ----------
    function renderResults(resultData) {
      const wrapper = document.getElementById('resultTableWrapper');
      const statsDiv = document.getElementById('statsDisplay');
      const statNew = document.getElementById('statNew');
      const statOld = document.getElementById('statOld');
      const statSimilar = document.getElementById('statSimilar');

      if (!resultData || resultData.results.length === 0) {
        wrapper.innerHTML = `<div class="empty-state">📭 No results to show. Paste both lists and compare.</div>`;
        statNew.textContent = '0'; statOld.textContent = '0'; statSimilar.textContent = '0';
        return;
      }

      const { results, stats } = resultData;
      statNew.textContent = stats.new;
      statOld.textContent = stats.old;
      statSimilar.textContent = stats.similar;

      let html = `<table>
        <thead><tr>
          <th>#</th>
          <th>Company (new)</th>
          <th>URL (new)</th>
          <th>Status</th>
          <th>Match</th>
          <th>Similarity</th>
          <th>Name %</th>
          <th>URL %</th>
        </tr></thead><tbody>`;

      results.forEach((r, idx) => {
        const newName = r.newItem.name || '—';
        const newUrl = r.newItem.url || '—';
        const masterName = r.masterMatch ? r.masterMatch.name : '—';
        const masterUrl = r.masterMatch ? r.masterMatch.url : '—';
        const sim = r.similarity;

        html += `<tr>
          <td>${idx+1}</td>
          <td><strong>${newName}</strong></td>
          <td class="url">${newUrl}</td>
          <td><span class="tag ${r.tagClass}">${r.statusLabel}</span></td>
          <td>${masterName !== '—' ? masterName : '❌ no match'}</td>
          <td>
            <div style="display:flex;align-items:center;gap:6px;">
              <div class="sim-bar"><div class="sim-fill" style="width:${Math.min(sim,100)}%;"></div></div>
              <span>${sim}%</span>
            </div>
          </td>
          <td>${r.nameSim}%</td>
          <td>${r.urlSim}%</td>
        </tr>`;
      });

      html += `</tbody></table>`;
      wrapper.innerHTML = html;
    }

    // ---------- event binding ----------
    document.getElementById('compareBtn').addEventListener('click', function() {
      const masterText = document.getElementById('masterInput').value;
      const newText = document.getElementById('newInput').value;
      if (!masterText.trim() || !newText.trim()) {
        alert('Please paste both master list and new list.');
        return;
      }
      const data = compareLists(masterText, newText);
      renderResults(data);
    });

    document.getElementById('clearBtn').addEventListener('click', function() {
      document.getElementById('masterInput').value = '';
      document.getElementById('newInput').value = '';
      document.getElementById('resultTableWrapper').innerHTML = `<div class="empty-state">⬆️ Lists cleared. Paste new data and compare.</div>`;
      document.getElementById('statNew').textContent = '0';
      document.getElementById('statOld').textContent = '0';
      document.getElementById('statSimilar').textContent = '0';
    });

    // optional: auto-compare with example data on load
    window.addEventListener('load', function() {
      // example already pre-filled, trigger compare after small delay
      setTimeout(() => {
        document.getElementById('compareBtn').click();
      }, 300);
    });

  })();
</script>

</body>
</html>
